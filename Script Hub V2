--[[
    Terminal UI Library
    A customizable terminal/console UI library for Roblox
    
    Usage:
        local TerminalLib = loadstring(game:HttpGet("your-url-here"))()
        
        local terminal = TerminalLib.new({
            username = "admin",
            hostname = "server",
            theme = "arch", -- "arch", "ubuntu", "windows", "matrix"
            fontSize = 14,
            enableMatrix = false
        })
        
        terminal:addCommand("hello", function(args)
            return "Hello, " .. (args[1] or "World") .. "!"
        end, "Greets the user")
        
        terminal:show()
]]

local TerminalLibrary = {}
TerminalLibrary.__index = TerminalLibrary
TerminalLibrary.Version = "1.0.0"

-- Themes Configuration
local Themes = {
    arch = {
        bgColor = Color3.fromRGB(10, 10, 10),
        textColor = Color3.fromRGB(203, 204, 205),
        accentColor = Color3.fromRGB(23, 147, 209),
        successColor = Color3.fromRGB(122, 192, 101),
        errorColor = Color3.fromRGB(255, 85, 85),
        warningColor = Color3.fromRGB(255, 203, 107),
        promptFormat = "[<user>@<host> <dir>]$ ",
        bootSequence = true,
        neofetch = true
    },
    ubuntu = {
        bgColor = Color3.fromRGB(48, 10, 36),
        textColor = Color3.fromRGB(255, 255, 255),
        accentColor = Color3.fromRGB(233, 84, 32),
        successColor = Color3.fromRGB(0, 255, 0),
        errorColor = Color3.fromRGB(255, 0, 0),
        warningColor = Color3.fromRGB(255, 255, 0),
        promptFormat = "<user>@<host>:<dir>$ ",
        bootSequence = false,
        neofetch = false
    },
    windows = {
        bgColor = Color3.fromRGB(12, 12, 12),
        textColor = Color3.fromRGB(204, 204, 204),
        accentColor = Color3.fromRGB(0, 120, 215),
        successColor = Color3.fromRGB(22, 198, 12),
        errorColor = Color3.fromRGB(231, 72, 86),
        warningColor = Color3.fromRGB(249, 241, 165),
        promptFormat = "<dir>> ",
        bootSequence = false,
        neofetch = false
    },
    matrix = {
        bgColor = Color3.fromRGB(0, 0, 0),
        textColor = Color3.fromRGB(0, 255, 65),
        accentColor = Color3.fromRGB(0, 255, 65),
        successColor = Color3.fromRGB(0, 255, 65),
        errorColor = Color3.fromRGB(255, 0, 0),
        warningColor = Color3.fromRGB(255, 255, 0),
        promptFormat = "> ",
        bootSequence = false,
        neofetch = false
    }
}

function TerminalLibrary.new(config)
    local self = setmetatable({}, TerminalLibrary)
    
    config = config or {}
    
    -- Theme setup
    local theme = Themes[config.theme or "arch"] or Themes.arch
    
    self.bgColor = config.bgColor or theme.bgColor
    self.textColor = config.textColor or theme.textColor
    self.accentColor = config.accentColor or theme.accentColor
    self.successColor = config.successColor or theme.successColor
    self.errorColor = config.errorColor or theme.errorColor
    self.warningColor = config.warningColor or theme.warningColor
    self.fontSize = config.fontSize or 13
    self.username = config.username or game.Players.LocalPlayer.Name:lower()
    self.hostname = config.hostname or "localhost"
    self.maxLines = config.maxLines or 300
    self.promptFormat = config.promptFormat or theme.promptFormat
    self.enableBootSequence = config.enableBootSequence ~= nil and config.enableBootSequence or theme.bootSequence
    self.enableNeofetch = config.enableNeofetch ~= nil and config.enableNeofetch or theme.neofetch
    self.enableMatrix = config.enableMatrix or false
    self.theme = config.theme or "arch"
    
    self.currentDir = "~"
    self.env = {
        HOME = "/home/" .. self.username,
        USER = self.username,
        SHELL = "/bin/bash",
        PATH = "/usr/local/bin:/usr/bin:/bin",
        TERM = "xterm-256color",
        EDITOR = "vim",
        LANG = "en_US.UTF-8"
    }
    
    -- File system
    self.fileSystem = {
        ["~"] = {type = "dir", children = {"Desktop", "Documents", "Downloads"}},
        ["~/Desktop"] = {type = "dir", children = {}},
        ["~/Documents"] = {type = "dir", children = {"readme.txt"}},
        ["~/Downloads"] = {type = "dir", children = {}},
        ["~/Documents/readme.txt"] = {type = "file", content = "Welcome to Terminal UI Library!"}
    }
    
    self.commands = {}
    self.history = {}
    self.historyIndex = 0
    self.output = {}
    self.booting = self.enableBootSequence
    self.matrixEnabled = false
    self.matrixColumns = {}
    
    -- Callbacks
    self.onCommandExecute = nil
    self.onShow = nil
    self.onHide = nil
    self.onDestroy = nil
    
    self:createUI()
    self:registerDefaultCommands()
    
    if self.enableBootSequence then
        self:startBootSequence()
    else
        self.booting = false
        self:updatePrompt()
        self.inputBox.Visible = true
        self.cursor.Visible = true
        task.wait()
        self.inputBox:CaptureFocus()
    end)
end

function TerminalLibrary:registerDefaultCommands()
    self:addCommand("help", function()
        local cmds = {}
        for name, data in pairs(self.commands) do
            table.insert(cmds, name .. " - " .. data.description)
        end
        table.sort(cmds)
        return "Available Commands:\n" .. table.concat(cmds, "\n")
    end, "Shows all available commands")
    
    self:addCommand("clear", function()
        self:clear()
        return ""
    end, "Clears the terminal screen")
    
    self:addCommand("echo", function(args)
        return table.concat(args, " ")
    end, "Prints text to the terminal")
    
    self:addCommand("history", function()
        if #self.history == 0 then return "No history" end
        local result = {}
        for i, cmd in ipairs(self.history) do
            table.insert(result, string.format("%5d  %s", i, cmd))
        end
        return table.concat(result, "\n")
    end, "Shows command history")
    
    self:addCommand("exit", function()
        self:destroy()
        return ""
    end, "Closes the terminal")
    
    self:addCommand("theme", function(args)
        if not args[1] then
            return "Available themes: arch, ubuntu, windows, matrix"
        end
        if self:setTheme(args[1]) then
            return "Theme changed to " .. args[1]
        else
            return "Invalid theme. Available: arch, ubuntu, windows, matrix"
        end
    end, "Changes terminal theme")
    
    self:addCommand("matrix", function()
        if self:toggleMatrix() then
            return "Matrix effect enabled"
        else
            return "Matrix effect disabled"
        end
    end, "Toggles Matrix rain effect")
    
    self:addCommand("ls", function(args)
        local path = self.currentDir
        if args[1] then
            path = self.currentDir .. "/" .. args[1]
        end
        
        local fs = self.fileSystem[path]
        if not fs then return "ls: cannot access '" .. (args[1] or ".") .. "': No such file or directory" end
        if fs.type ~= "dir" then return "ls: " .. (args[1] or ".") .. ": Not a directory" end
        
        local items = {}
        for _, item in ipairs(fs.children) do
            table.insert(items, item)
        end
        return table.concat(items, "  ")
    end, "Lists directory contents")
    
    self:addCommand("cd", function(args)
        if not args[1] or args[1] == "~" then
            self.currentDir = "~"
        elseif args[1] == ".." then
            if self.currentDir ~= "~" then
                local parts = {}
                for part in self.currentDir:gmatch("[^/]+") do
                    table.insert(parts, part)
                end
                table.remove(parts)
                self.currentDir = #parts > 0 and table.concat(parts, "/") or "~"
            end
        else
            local newPath = self.currentDir .. "/" .. args[1]
            if not self.fileSystem[newPath] then
                return "cd: " .. args[1] .. ": No such file or directory"
            end
            if self.fileSystem[newPath].type ~= "dir" then
                return "cd: " .. args[1] .. ": Not a directory"
            end
            self.currentDir = newPath
        end
        self:updatePrompt()
        return ""
    end, "Changes directory")
    
    self:addCommand("cat", function(args)
        if not args[1] then return "cat: missing file operand" end
        local path = self.currentDir .. "/" .. args[1]
        local fs = self.fileSystem[path]
        if not fs then return "cat: " .. args[1] .. ": No such file or directory" end
        if fs.type ~= "file" then return "cat: " .. args[1] .. ": Is a directory" end
        return fs.content
    end, "Displays file contents")
    
    self:addCommand("whoami", function()
        return self.username
    end, "Shows current username")
    
    self:addCommand("pwd", function()
        return self.currentDir == "~" and "/home/" .. self.username or "/home/" .. self.username .. "/" .. self.currentDir:gsub("~/", "")
    end, "Shows current directory")
    
    self:addCommand("mkdir", function(args)
        if not args[1] then return "mkdir: missing operand" end
        local path = self.currentDir .. "/" .. args[1]
        if self.fileSystem[path] then return "mkdir: cannot create directory '" .. args[1] .. "': File exists" end
        self.fileSystem[path] = {type = "dir", children = {}}
        table.insert(self.fileSystem[self.currentDir].children, args[1])
        return ""
    end, "Creates a new directory")
    
    self:addCommand("touch", function(args)
        if not args[1] then return "touch: missing file operand" end
        local path = self.currentDir .. "/" .. args[1]
        if self.fileSystem[path] then return "" end
        self.fileSystem[path] = {type = "file", content = ""}
        table.insert(self.fileSystem[self.currentDir].children, args[1])
        return ""
    end, "Creates a new file")
    
    self:addCommand("rm", function(args)
        if not args[1] then return "rm: missing operand" end
        local path = self.currentDir .. "/" .. args[1]
        if not self.fileSystem[path] then return "rm: cannot remove '" .. args[1] .. "': No such file or directory" end
        
        self.fileSystem[path] = nil
        local children = self.fileSystem[self.currentDir].children
        for i, child in ipairs(children) do
            if child == args[1] then
                table.remove(children, i)
                break
            end
        end
        return ""
    end, "Removes a file or directory")
    
    self:addCommand("date", function()
        return os.date("%a %b %d %I:%M:%S %p %Y")
    end, "Shows current date and time")
    
    self:addCommand("version", function()
        return "Terminal UI Library v" .. TerminalLibrary.Version
    end, "Shows library version")
end

