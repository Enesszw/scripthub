function TerminalLibrary:setupInput()
    self.inputBox:GetPropertyChangedSignal("Text"):Connect(function()
        local textBounds = game:GetService("TextService"):GetTextSize(
            self.inputBox.Text,
            self.fontSize,
            Enum.Font.Code,
            Vector2.new(1000, 1000)
        )
        self.cursor.Position = UDim2.new(0, 405 + textBounds.X, 0, 8)
    end)
    
    self.inputBox.FocusLost:Connect(function(enterPressed)
        if enterPressed and not self.booting then
            self:executeCommand(self.inputBox.Text)
            self.inputBox.Text = ""
            self.historyIndex = 0
            task.wait()
            self.inputBox:CaptureFocus()
        end
    end)
    
    local UserInputService = game:GetService("UserInputService")
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if self.inputBox:IsFocused() and not self.booting then
            if input.KeyCode == Enum.KeyCode.Up then
                self:navigateHistory(-1)
            elseif input.KeyCode == Enum.KeyCode.Down then
                self:navigateHistory(1)
            elseif input.KeyCode == Enum.KeyCode.L and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                self:clear()
            elseif input.KeyCode == Enum.KeyCode.C and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                self:writeLine("^C", self.textColor)
                self:updatePrompt()
                self.inputBox.Text = ""
            end
        end
    end)
end

-- Public API Methods

function TerminalLibrary:addCommand(name, callback, description)
    self.commands[name:lower()] = {
        callback = callback,
        description = description or "No description available"
    }
end

function TerminalLibrary:removeCommand(name)
    self.commands[name:lower()] = nil
end

function TerminalLibrary:writeLine(text, color)
    color = color or self.textColor
    local r, g, b = math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255)
    table.insert(self.output, "<font color='rgb(" .. r .. "," .. g .. "," .. b .. ")'>" .. text .. "</font>")
    
    if #self.output > self.maxLines then
        table.remove(self.output, 1)
    end
    
    self:updateOutput()
end

function TerminalLibrary:writeSuccess(text)
    self:writeLine(text, self.successColor)
end

function TerminalLibrary:writeError(text)
    self:writeLine(text, self.errorColor)
end

function TerminalLibrary:writeWarning(text)
    self:writeLine(text, self.warningColor)
end

function TerminalLibrary:clear()
    self.output = {}
    self:updateOutput()
end

function TerminalLibrary:show()
    self.gui.Enabled = true
    self.bg.Visible = true
    if not self.booting then
        self.inputBox:CaptureFocus()
    end
    if self.onShow then
        self.onShow()
    end
end

function TerminalLibrary:hide()
    self.gui.Enabled = false
    self.bg.Visible = false
    if self.onHide then
        self.onHide()
    end
end

function TerminalLibrary:destroy()
    if self.onDestroy then
        self.onDestroy()
    end
    if self.gui then
        self.gui:Destroy()
    end
end

function TerminalLibrary:toggleMatrix()
    self.matrixEnabled = not self.matrixEnabled
    self.matrixCanvas.Visible = self.matrixEnabled
    
    if self.matrixEnabled then
        self:createMatrixEffect()
        return true
    end
    return false
end

function TerminalLibrary:setTheme(themeName)
    local theme = Themes[themeName]
    if not theme then return false end
    
    self.bgColor = theme.bgColor
    self.textColor = theme.textColor
    self.accentColor = theme.accentColor
    self.successColor = theme.successColor
    self.errorColor = theme.errorColor
    self.warningColor = theme.warningColor
    
    self.frame.BackgroundColor3 = self.bgColor
    self.outputText.TextColor3 = self.textColor
    self.inputBox.TextColor3 = self.textColor
    self.promptLabel.TextColor3 = self.accentColor
    
    return true
end

-- Internal Methods

function TerminalLibrary:executeCommand(input)
    input = input:match("^%s*(.-)%s*$")
    
    if input == "" then
        self:writeLine("")
        self:updatePrompt()
        return
    end
    
    table.insert(self.history, input)
    if #self.history > 100 then
        table.remove(self.history, 1)
    end
    
    local promptText = self:formatPrompt()
    self:writeLine(promptText .. input, self.textColor)
    
    local parts = {}
    for part in input:gmatch("%S+") do
        table.insert(parts, part)
    end
    
    local cmdName = parts[1]:lower()
    table.remove(parts, 1)
    
    local cmd = self.commands[cmdName]
    if cmd then
        local success, result = pcall(cmd.callback, parts)
        if success then
            if result and result ~= "" then
                self:writeLine(result, self.textColor)
            end
        else
            self:writeError("Error: " .. tostring(result))
        end
    else
        self:writeError(cmdName .. ": command not found")
    end
    
    if self.onCommandExecute then
        self.onCommandExecute(cmdName, parts)
    end
    
    self:updatePrompt()
end

function TerminalLibrary:formatPrompt()
    local prompt = self.promptFormat
    prompt = prompt:gsub("<user>", "<font color='rgb(" .. math.floor(self.successColor.R * 255) .. "," .. math.floor(self.successColor.G * 255) .. "," .. math.floor(self.successColor.B * 255) .. ")'>" .. self.username .. "</font>")
    prompt = prompt:gsub("<host>", "<font color='rgb(" .. math.floor(self.accentColor.R * 255) .. "," .. math.floor(self.accentColor.G * 255) .. "," .. math.floor(self.accentColor.B * 255) .. ")'>" .. self.hostname .. "</font>")
    prompt = prompt:gsub("<dir>", "<font color='rgb(" .. math.floor(self.warningColor.R * 255) .. "," .. math.floor(self.warningColor.G * 255) .. "," .. math.floor(self.warningColor.B * 255) .. ")'>" .. self.currentDir .. "</font>")
    return prompt
end

function TerminalLibrary:updatePrompt()
    self.promptLabel.Text = self:formatPrompt()
    self.titleLabel.Text = "  Terminal - " .. self.username .. "@" .. self.hostname .. ":" .. self.currentDir
end

function TerminalLibrary:updateOutput()
    self.outputText.Text = table.concat(self.output, "\n")
    
    local textBounds = self.outputText.TextBounds
    self.scrollFrame.CanvasSize = UDim2.new(0, 0, 0, textBounds.Y + 30)
    self.scrollFrame.CanvasPosition = Vector2.new(0, self.scrollFrame.CanvasSize.Y.Offset)
end

function TerminalLibrary:navigateHistory(direction)
    if #self.history == 0 then return end
    
    self.historyIndex = math.clamp(self.historyIndex + direction, 0, #self.history)
    
    if self.historyIndex == 0 then
        self.inputBox.Text = ""
    else
        self.inputBox.Text = self.history[#self.history - self.historyIndex + 1]
    end
end

function TerminalLibrary:makeDraggable(frame, dragHandle)
    local dragging, dragStart, startPos
    local UserInputService = game:GetService("UserInputService")
    
    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

function TerminalLibrary:createMatrixEffect()
    self.matrixCanvas:ClearAllChildren()
    self.matrixColumns = {}
    
    local matrixChars = {"0", "1", "ア", "イ", "ウ", "エ", "オ", "カ", "キ"}
    local numColumns = 20
    local columnWidth = self.frame.AbsoluteSize.X / numColumns
    
    for i = 1, numColumns do
        local column = Instance.new("Frame")
        column.Name = "Column" .. i
        column.Size = UDim2.new(0, columnWidth, 1, 0)
        column.Position = UDim2.new(0, (i - 1) * columnWidth, 0, 0)
        column.BackgroundTransparency = 1
        column.BorderSizePixel = 0
        column.ZIndex = 9
        column.Parent = self.matrixCanvas
        
        local numLabels = 12
        local columnData = {
            frame = column,
            labels = {},
            speed = math.random(20, 50) / 10,
            position = math.random(-400, 0),
            length = math.random(6, 12),
            active = true,
            updateCounter = 0
        }
        
        for j = 1, numLabels do
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 0, 24)
            label.BackgroundTransparency = 1
            label.Text = matrixChars[math.random(1, #matrixChars)]
            label.TextColor3 = Color3.fromRGB(0, 255, 65)
            label.TextSize = 14
            label.Font = Enum.Font.Code
            label.TextTransparency = 1
            label.ZIndex = 9
            label.Parent = column
            
            table.insert(columnData.labels, label)
        end
        
        table.insert(self.matrixColumns, columnData)
    end
    
    task.spawn(function()
        while self.matrixEnabled and self.matrixCanvas do
            for _, col in ipairs(self.matrixColumns) do
                if col.active then
                    col.position = col.position + col.speed
                    col.updateCounter = col.updateCounter + 1
                    
                    for i, label in ipairs(col.labels) do
                        local yPos = col.position + (i * 24)
                        label.Position = UDim2.new(0, 0, 0, yPos)
                        
                        local distFromHead = i
                        if distFromHead <= col.length then
                            if distFromHead == 1 then
                                label.TextColor3 = Color3.fromRGB(200, 255, 200)
                                label.TextTransparency = 0
                            else
                                local fade = distFromHead / col.length
                                label.TextColor3 = Color3.fromRGB(0, 255, 65)
                                label.TextTransparency = fade
                            end
                            
                            if col.updateCounter % 10 == 0 and math.random() < 0.3 then
                                label.Text = matrixChars[math.random(1, #matrixChars)]
                            end
                        else
                            label.TextTransparency = 1
                        end
                    end
                    
                    if col.position > self.matrixCanvas.AbsoluteSize.Y + 100 then
                        col.position = math.random(-300, -100)
                        col.speed = math.random(20, 50) / 10
                        col.length = math.random(6, 12)
                    end
                end
            end
            
            task.wait(0.05)
        end
    end)
end

function TerminalLibrary:startBootSequence()
    task.spawn(function()
        self:writeLine("                     GNU GRUB  version 2.12", self.textColor)
        self:writeLine("")
        task.wait(0.5)
        
        local archColor = self.accentColor
        local r, g, b = math.floor(archColor.R * 255), math.floor(archColor.G * 255), math.floor(archColor.B * 255)
        local ac = "rgb(" .. r .. "," .. g .. "," .. b .. ")"
        
        self:writeLine(" <font color='" .. ac .. "'>┌────────────────────────────────────────────────────────────┐</font>")
        self:writeLine(" <font color='" .. ac .. "'>│</font> <font color='rgb(255,255,255)' weight='bold'>  Arch Linux                                               </font> <font color='" .. ac .. "'>│</font>")
        self:writeLine(" <font color='" .. ac .. "'>│</font>   Arch Linux (fallback initramfs)                        <font color='" .. ac .. "'>│</font>")
        self:writeLine(" <font color='" .. ac .. "'>└────────────────────────────────────────────────────────────┘</font>")
        self:writeLine("")
        task.wait(0.8)
        
        self:writeLine("Loading Linux...", self.textColor)
        task.wait(0.3)
        
        self:writeSuccess("[  OK  ] Reached target Multi-User System")
        task.wait(0.2)
        
        self:writeLine("")
        self:writeLine(self.hostname .. " login: " .. self.username, self.textColor)
        task.wait(0.3)
        
        self:writeLine("Last login: " .. os.date("%a %b %d %H:%M:%S %Y"), self.textColor)
        self:writeLine("")
        
        self.booting = false
        self:updatePrompt()
        self.inputBox.
