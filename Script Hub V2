--[[ 
    Arch Linux Terminal UI Library 
    Converted & Optimized
]]

local ArchUI = {}
ArchUI.__index = ArchUI

-- Terminal Class
local Terminal = {}
Terminal.__index = Terminal

-- Varsayılan Ayarlar
local DefaultConfig = {
    username = "user",
    hostname = "arch",
    bgColor = Color3.fromRGB(10, 10, 10),
    textColor = Color3.fromRGB(203, 204, 205),
    archBlue = Color3.fromRGB(23, 147, 209),
    green = Color3.fromRGB(122, 192, 101),
    red = Color3.fromRGB(255, 85, 85),
    yellow = Color3.fromRGB(255, 203, 107),
    fontSize = 13,
    maxLines = 300,
    draggable = true
}

function ArchUI.new(config)
    local self = setmetatable({}, Terminal)
    
    config = config or {}
    for k, v in pairs(DefaultConfig) do
        self[k] = config[k] or v
    end

    -- Parent ayarı (Otomatik PlayerGui bulur)
    local player = game:GetService("Players").LocalPlayer
    local parent = config.parent or (player and player:WaitForChild("PlayerGui"))
    
    if not parent then
        warn("ArchUI: Parent bulunamadı!")
        return nil
    end

    -- Dosya Sistemi ve Ortam Değişkenleri
    self.currentDir = "~"
    self.env = {
        HOME = "/home/" .. self.username,
        USER = self.username,
        SHELL = "/bin/bash",
        PATH = "/usr/local/bin:/usr/bin:/bin",
        TERM = "xterm-256color",
        EDITOR = "vim",
        LANG = "en_US.UTF-8"
    }
    
    -- Varsayılan Dosya Sistemi
    self.fileSystem = {
        ["~"] = {type = "dir", children = {"Desktop", "Documents", "Downloads", ".bashrc"}},
        ["~/Desktop"] = {type = "dir", children = {}},
        ["~/Documents"] = {type = "dir", children = {"readme.txt"}},
        ["~/Downloads"] = {type = "dir", children = {}},
        ["~/.bashrc"] = {type = "file", content = "alias ls='ls --color=auto'\nPS1='[\\u@\\h \\W]\\$ '"},
        ["~/Documents/readme.txt"] = {type = "file", content = "ArchUI Library v1.0\nCreated for custom scripting."}
    }
    
    self.commands = {}
    self.history = {}
    self.historyIndex = 0
    self.output = {}
    self.booting = true
    self.matrixEnabled = false
    self.matrixColumns = {}
    
    self:createUI(parent)
    
    -- Eğer config'de bootanimasyonunu kapatmak istersen: config.skipBoot = true
    if config.skipBoot then
        self.booting = false
        self:registerDefaultCommands()
        self:updatePrompt()
        self.inputBox.Visible = true
        self.cursor.Visible = true
        self:Print("<font color='rgb(122,192,101)'>System Ready.</font>")
        task.wait()
        self.inputBox:CaptureFocus()
    else
        self:startBootSequence()
    end
    
    return self
end

-- UI Oluşturma
function Terminal:createUI(parent)
    local sg = Instance.new("ScreenGui")
    sg.Name = "ArchTerminalUI"
    sg.ResetOnSpawn = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.IgnoreGuiInset = true
    sg.Parent = parent
    
    local bg = Instance.new("Frame")
    bg.Name = "Background"
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    bg.BackgroundTransparency = 0.3
    bg.Visible = false
    bg.Parent = sg
    
    local frame = Instance.new("Frame")
    frame.Name = "TerminalWindow"
    frame.Size = UDim2.new(0, 800, 0, 500) -- Varsayılan boyut
    frame.Position = UDim2.new(0.5, -400, 0.5, -250)
    frame.BackgroundColor3 = self.bgColor
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = true
    frame.Parent = sg
    
    -- Matrix Canvas
    local matrixCanvas = Instance.new("Frame")
    matrixCanvas.Name = "MatrixCanvas"
    matrixCanvas.Size = UDim2.new(1, 0, 1, -30)
    matrixCanvas.Position = UDim2.new(0, 0, 0, 30)
    matrixCanvas.BackgroundTransparency = 1
    matrixCanvas.Visible = false
    matrixCanvas.ZIndex = 1
    matrixCanvas.ClipsDescendants = true
    matrixCanvas.Parent = frame
    self.matrixCanvas = matrixCanvas

    -- Title Bar
    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 30)
    titleBar.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    titleBar.BorderSizePixel = 0
    titleBar.Parent = frame
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -80, 1, 0)
    titleLabel.Position = UDim2.new(0, 12, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = self.username .. "@" .. self.hostname .. ":~"
    titleLabel.TextColor3 = self.textColor
    titleLabel.Font = Enum.Font.Code
    titleLabel.TextSize = 12
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = titleBar
    self.titleLabel = titleLabel

    -- Close Button
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 12, 0, 12)
    closeBtn.Position = UDim2.new(1, -25, 0.5, -6)
    closeBtn.BackgroundColor3 = self.red
    closeBtn.Text = ""
    closeBtn.Parent = titleBar
    local corner = Instance.new("UICorner", closeBtn); corner.CornerRadius = UDim.new(1,0)
    
    closeBtn.MouseButton1Click:Connect(function()
        self:Destroy()
    end)
    
    -- Output Area
    local scrollFrame = Instance.new("ScrollingFrame")
    scrollFrame.Size = UDim2.new(1, -20, 1, -70)
    scrollFrame.Position = UDim2.new(0, 10, 0, 35)
    scrollFrame.BackgroundTransparency = 1
    scrollFrame.ScrollBarThickness = 4
    scrollFrame.ScrollBarImageColor3 = Color3.fromRGB(60,60,60)
    scrollFrame.CanvasSize = UDim2.new(0,0,0,0)
    scrollFrame.Parent = frame
    self.scrollFrame = scrollFrame
    
    local outputText = Instance.new("TextLabel")
    outputText.Size = UDim2.new(1, 0, 1, 0)
    outputText.BackgroundTransparency = 1
    outputText.Text = ""
    outputText.TextColor3 = self.textColor
    outputText.TextSize = self.fontSize
    outputText.Font = Enum.Font.Code
    outputText.TextXAlignment = Enum.TextXAlignment.Left
    outputText.TextYAlignment = Enum.TextYAlignment.Top
    outputText.RichText = true
    outputText.TextWrapped = true
    outputText.Parent = scrollFrame
    self.outputText = outputText
    
    -- Input Area
    local inputFrame = Instance.new("Frame")
    inputFrame.Size = UDim2.new(1, -20, 0, 25)
    inputFrame.Position = UDim2.new(0, 10, 1, -30)
    inputFrame.BackgroundTransparency = 1
    inputFrame.Parent = frame
    
    local promptLabel = Instance.new("TextLabel")
    promptLabel.Size = UDim2.new(0, 10, 1, 0) 
    promptLabel.BackgroundTransparency = 1
    promptLabel.Text = "" -- Dinamik olarak güncellenecek
    promptLabel.TextColor3 = self.archBlue
    promptLabel.TextSize = self.fontSize
    promptLabel.Font = Enum.Font.Code
    promptLabel.TextXAlignment = Enum.TextXAlignment.Left
    promptLabel.RichText = true
    promptLabel.Parent = inputFrame
    self.promptLabel = promptLabel
    
    local inputBox = Instance.new("TextBox")
    inputBox.Position = UDim2.new(0, 10, 0, 0)
    inputBox.Size = UDim2.new(1, -10, 1, 0)
    inputBox.BackgroundTransparency = 1
    inputBox.Text = ""
    inputBox.TextColor3 = self.textColor
    inputBox.TextSize = self.fontSize
    inputBox.Font = Enum.Font.Code
    inputBox.TextXAlignment = Enum.TextXAlignment.Left
    inputBox.ClearTextOnFocus = false
    inputBox.Visible = false
    inputBox.Parent = inputFrame
    self.inputBox = inputBox
    
    -- Cursor logic
    local cursor = Instance.new("Frame")
    cursor.Size = UDim2.new(0, 8, 0, 16)
    cursor.BackgroundColor3 = self.textColor
    cursor.Visible = false
    cursor.Parent = inputFrame
    self.cursor = cursor

    task.spawn(function()
        while cursor.Parent do
            cursor.Visible = not cursor.Visible
            task.wait(0.5)
        end
    end)
    
    -- Event Listeners
    if self.draggable then
        self:makeDraggable(frame, titleBar)
    end
    
    inputBox:GetPropertyChangedSignal("Text"):Connect(function()
        local promptSize = game:GetService("TextService"):GetTextSize(promptLabel.Text, self.fontSize, Enum.Font.Code, Vector2.new(1000, 25))
        local textSize = game:GetService("TextService"):GetTextSize(inputBox.Text, self.fontSize, Enum.Font.Code, Vector2.new(1000, 25))
        
        promptLabel.Size = UDim2.new(0, promptSize.X, 1, 0)
        inputBox.Position = UDim2.new(0, promptSize.X + 5, 0, 0)
        inputBox.Size = UDim2.new(1, -(promptSize.X + 5), 1, 0)
        cursor.Position = UDim2.new(0, promptSize.X + 5 + textSize.X, 0, 4)
    end)
    
    inputBox.FocusLost:Connect(function(enter)
        if enter and not self.booting then
            self:executeCommand(inputBox.Text)
            inputBox.Text = ""
            self.historyIndex = 0
            task.wait()
            inputBox:CaptureFocus()
        end
    end)
    
    self.gui = sg
    self.frame = frame
end

-- --- API FONKSİYONLARI ---

-- Özel Komut Ekleme
function Terminal:AddCommand(name, callback, description)
    self.commands[name:lower()] = {
        callback = callback,
        description = description or "Custom command"
    }
end

-- Terminale Yazı Yazdırma
function Terminal:Print(text)
    self:writeLineColored(text)
end

-- Terminali Temizleme
function Terminal:Clear()
    self.output = {}
    self:updateOutput()
end

-- Terminali Kapatma/Yok Etme
function Terminal:Destroy()
    if self.gui then self.gui:Destroy() end
    self = nil
end

-- --- İÇ FONKSİYONLAR (CORE) ---

function Terminal:writeLineColored(text)
    table.insert(self.output, text)
    if #self.output > self.maxLines then table.remove(self.output, 1) end
    self:updateOutput()
end

function Terminal:updateOutput()
    self.outputText.Text = table.concat(self.output, "\n")
    local bounds = self.outputText.TextBounds
    self.scrollFrame.CanvasSize = UDim2.new(0, 0, 0, bounds.Y + 30)
    self.scrollFrame.CanvasPosition = Vector2.new(0, self.scrollFrame.CanvasSize.Y.Offset)
end

function Terminal:updatePrompt()
    -- Renkli prompt metni
    local userColor = "rgb("..math.floor(self.green.R*255)..","..math.floor(self.green.G*255)..","..math.floor(self.green.B*255)..")"
    local hostColor = "rgb("..math.floor(self.archBlue.R*255)..","..math.floor(self.archBlue.G*255)..","..math.floor(self.archBlue.B*255)..")"
    local dirColor = "rgb("..math.floor(self.yellow.R*255)..","..math.floor(self.yellow.G*255)..","..math.floor(self.yellow.B*255)..")"
    
    self.promptLabel.Text = string.format("[<font color='%s'>%s</font>@<font color='%s'>%s</font> <font color='%s'>%s</font>]$ ", 
        userColor, self.username, hostColor, self.hostname, dirColor, self.currentDir)
    
    self.titleLabel.Text = self.username .. "@" .. self.hostname .. ":" .. self.currentDir
    
    -- Input box pozisyonunu güncellemek için tetikle
    self.inputBox.Text = self.inputBox.Text .. " "
    self.inputBox.Text = string.sub(self.inputBox.Text, 1, -2)
end

function Terminal:executeCommand(input)
    input = input:match("^%s*(.-)%s*$")
    if input == "" then self:writeLineColored(""); self:updatePrompt(); return end
    
    table.insert(self.history, input)
    self:writeLineColored(self.promptLabel.Text .. input)
    
    local parts = {}
    for part in input:gmatch("%S+") do table.insert(parts, part) end
    local cmdName = table.remove(parts, 1):lower()
    
    if self.commands[cmdName] then
        local success, result = pcall(self.commands[cmdName].callback, parts)
        if success and result then self:writeLineColored(result)
        elseif not success then self:writeLineColored("<font color='rgb(255,85,85)'>Error:</font> " .. tostring(result)) end
    else
        self:writeLineColored("bash: " .. cmdName .. ": command not found")
    end
    self:updatePrompt()
end

function Terminal:registerDefaultCommands()
    self:AddCommand("clear", function() self:Clear() end, "Clears terminal")
    self:AddCommand("echo", function(args) return table.concat(args, " ") end, "Print args")
    self:AddCommand("help", function() 
        local list = {}
        for k,v in pairs(self.commands) do table.insert(list, k) end
        table.sort(list)
        return "<font color='rgb(23,147,209)'>Commands:</font> " .. table.concat(list, ", ")
    end, "List commands")
    self:AddCommand("matrix", function() return self:toggleMatrix() end, "Toggle matrix effect")
    self:AddCommand("exit", function() self:Destroy() end, "Close terminal")
    
    -- Diğer temel komutlar (ls, cd, pwd, whoami vb.) buraya eklenebilir.
    -- Kodun kısalığı için temel örnekler bırakıldı.
end

function Terminal:startBootSequence()
    task.spawn(function()
        self:Print("<font color='rgb(203,204,205)'>GNU GRUB version 2.12</font>")
        task.wait(0.5)
        self:Print("<font color='rgb(23,147,209)'>Arch Linux Booting...</font>")
        
        local bootMsgs = {
            "[  OK  ] Started Network Manager",
            "[  OK  ] Reached target Graphical Interface",
        }
        for _, msg in ipairs(bootMsgs) do
            self:Print("<font color='rgb(122,192,101)'>"..msg.."</font>")
            task.wait(0.1)
        end
        
        self.booting = false
        self:registerDefaultCommands()
        self:updatePrompt()
        self.inputBox.Visible = true
        self.cursor.Visible = true
        self:Print("")
        self:Print("Welcome to <font color='rgb(23,147,209)'>Arch Linux</font> UI Library")
        task.wait()
        self.inputBox:CaptureFocus()
    end)
end

-- Matrix Efekti
function Terminal:toggleMatrix()
    self.matrixEnabled = not self.matrixEnabled
    self.matrixCanvas.Visible = self.matrixEnabled
    
    if self.matrixEnabled then
        self:createMatrixEffect()
        return "<font color='rgb(0,255,65)'>Matrix effect enabled</font>"
    else
        return "<font color='rgb(122,192,101)'>Matrix effect disabled</font>"
    end
end

function Terminal:createMatrixEffect()
    self.matrixCanvas:ClearAllChildren()
    local cols = 20
    local width = self.frame.AbsoluteSize.X / cols
    local chars = {"0", "1", "£", "¥"}
    
    task.spawn(function()
        while self.matrixEnabled and self.matrixCanvas.Parent do
            -- Basit matrix mantığı (Performans için optimize edildi)
            if math.random() > 0.8 then
                local drop = Instance.new("TextLabel")
                drop.Position = UDim2.new(0, math.random(0, cols)*width, 0, -20)
                drop.Size = UDim2.new(0, width, 0, 20)
                drop.BackgroundTransparency = 1
                drop.Text = chars[math.random(1, #chars)]
                drop.TextColor3 = Color3.fromRGB(0, 255, 65)
                drop.Parent = self.matrixCanvas
                
                game:GetService("TweenService"):Create(drop, TweenInfo.new(2), {
                    Position = UDim2.new(drop.Position.X.Scale, drop.Position.X.Offset, 1, 0),
                    TextTransparency = 1
                }):Play()
                
                game:GetService("Debris"):AddItem(drop, 2)
            end
            task.wait(0.05)
        end
    end)
end

function Terminal:makeDraggable(frame, dragHandle)
	local dragging, dragStart, startPos
	local UserInputService = game:GetService("UserInputService")
	
	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
end

return ArchUI
